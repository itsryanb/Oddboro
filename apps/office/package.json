{
  "name": "@oddboro/office",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "prettier --check . --ignore-path ../../.prettierignore",
    "pretest": "npm run build -w @oddboro/sprites",
    "test": "node --test --experimental-test-module-mocks \"src/**/*.test.ts\"",
    "service:install": "node scripts/office-service.ts",
    "service:uninstall": "node scripts/office-service.ts uninstall"
  },
  "dependencies": {
    "@oddboro/ledger": "*",
    "@oddboro/sprites": "*",
    "@oddboro/world": "*",
    "@sentry/core": "^11.10.0",
    "@sentry/sveltekit": "^11.10.0"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "~3.1156.0",
    "@aws-sdk/client-sso": "~3.1156.0",
    "@aws-sdk/client-sso-oidc": "~3.1156.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist-pixel": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "layerchart": "~2.8.0",
    "markdown-it": "^14.3.3",
    "pixi.js": "^8.22.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  }
}
