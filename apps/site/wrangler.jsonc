// The website on Cloudflare: Workers serving the static build in build/, at
// oddboro.com. The other Oddboro domains redirect here with zone rules, not
// from this Worker. Deploy with `npm run deploy -w @oddboro/site`.
{
  "name": "oddboro-site",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./build"
  },
  "routes": [{ "pattern": "oddboro.com", "custom_domain": true }],
  "workers_dev": false
}
